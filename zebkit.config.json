{
  "$schema": "./node_modules/zebkit/dist/editor/schemas/zebkit.config.schema.json",
  "configVersion": 3,
  "tokens": {
    "destinationPath": "./src/lib/styles",
    "assetFilePath": "/",
    "extendedTokens": {
      "colors": "all",
      "breakpoints": true
    },
    "prune": {
      "enabled": false,
      "content": [
        "./src/**/*.{html,js,md,svelte,ts}"
      ],
      "safelist": [
        "/^zbk-code-block/"
      ],
      "output": {
        "mode": "replace"
      },
      "tokens": true,
      "report": true
    }
  },
  "theme": {
    "name": "dynamowaves",
    "preset": "dynamowaves",
    "tokenPath": "./tokens",
    "overlays": [
      {
        "name": "dark",
        "tokenPath": "./themes/dark"
      }
    ]
  },
  "components": {
    "accordion": false,
    "badge": false,
    "breadcrumb": false,
    "button": {
      "variants": [
        "ghost",
        "lg",
        "sm"
      ]
    },
    "card": false,
    "checkbox": false,
    "code-block": {
      "options": {
        "tabsVariant": "code-block",
        "buttonVariant": "code-block-copy code-block-copy-size code-block-copy-motion"
      }
    },
    "dialog": false,
    "disclosure": false,
    "input": false,
    "link": {
      "variants": [
        "subtle"
      ]
    },
    "menu": false,
    "menu-item": false,
    "pagination": false,
    "panel": false,
    "popover": false,
    "radio": false,
    "select": false,
    "tag": false,
    "tabs": {
      "variants": []
    },
    "textarea": false,
    "toast": false,
    "toast-region": false,
    "toggle": {
      "variants": []
    },
    "tooltip": false
  },
  "context": {
    "path": "./zebkit/context"
  },
  "check": {
    "content": [
      "./src/**/*.{html,js,md,svelte,ts}"
    ]
  },
  "runtime": {
    "delivery": "generated",
    "path": "./zebkit/zebkit.runtime.js"
  },
  "accessibility": {
    "inputPath": "./src/lib/styles/zebkit-a11y-input.json",
    "delivery": "auto",
    "verify": {
      "reportDirectory": ".zebkit/reports",
      "routes": [
        {
          "id": "docs",
          "path": "/"
        }
      ],
      "viewports": [
        {
          "id": "mobile",
          "width": 375,
          "height": 812
        },
        {
          "id": "desktop",
          "width": 1440,
          "height": 1000
        },
        {
          "id": "reflow",
          "width": 320,
          "height": 800,
          "reflow": true
        }
      ],
      "themes": [
        {
          "id": "light",
          "selector": "html",
          "attribute": "data-zbk-theme"
        },
        {
          "id": "dark",
          "selector": "html",
          "attribute": "data-zbk-theme",
          "value": "dark"
        }
      ],
      "scenarios": [
        {
          "id": "wave-regenerated",
          "route": "docs",
          "actions": [
            {
              "action": "click",
              "selector": "[data-wave-regenerate]"
            }
          ]
        },
        {
          "id": "transition-advanced",
          "route": "docs",
          "actions": [
            {
              "action": "click",
              "selector": "[data-transition-next]"
            }
          ]
        }
      ]
    }
  }
}
