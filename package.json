{
  "name": "dynamowaves",
  "version": "2.2.1",
  "type": "module",
  "description": "Lightweight, dependency-free SVG wave templates that dynamically generate themselves on render.",
  "main": "./dist/dynamowaves.cjs",
  "module": "./dist/dynamowaves.esm.js",
  "types": "./dist/dynamowaves.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dynamowaves.d.ts",
      "import": "./dist/dynamowaves.esm.js",
      "require": "./dist/dynamowaves.cjs",
      "default": "./dist/dynamowaves.esm.js"
    },
    "./dist/dynamowaves.js": "./dist/dynamowaves.js",
    "./dist/dynamowaves.min.js": "./dist/dynamowaves.min.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test",
    "test:browser": "node browser-tests/dynamowaves.browser.js",
    "build": "rollup -c",
    "dev:docs": "vite dev",
    "build:docs": "npm run build && npx zebkit build && vite build",
    "check:docs": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npx zebkit check --format=json",
    "preview:docs": "vite preview",
    "verify:docs": "zebkit verify --url http://localhost:4173",
    "docs:build": "npm run build:docs",
    "docs:watch": "npm run dev:docs",
    "check:zebkit": "zebkit check --format=json",
    "prepublishOnly": "npm run build",
    "release": "npm publish",
    "release:dry": "npm run build && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzebley/dynamowaves.git"
  },
  "keywords": [
    "javascript",
    "svg",
    "html",
    "waves",
    "wave",
    "generative",
    "templates-html"
  ],
  "author": "Mark Zebley",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mzebley/dynamowaves/issues"
  },
  "homepage": "https://dynamowaves.markzebley.com/",
  "devDependencies": {
    "@mzebley/zebkit": "0.16.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.0",
    "lit": "^3.3.1",
    "mdsvex": "^0.12.8",
    "playwright": "^1.62.1",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.1.1",
    "shiki": "^4.4.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "zebkit": "npm:@mzebley/zebkit@0.16.1"
  },
  "overrides": {
    "immutable": "^5.1.9",
    "yaml": "^2.9.0"
  }
}
