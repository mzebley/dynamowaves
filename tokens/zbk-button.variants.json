{
  "button": {
    "lg": {
      "axis": "size",
      "description": "Larger type and padding.",
      "overrides": {
        "font-size": "{font-size.md}",
        "padding-inline": "{spacing.md}",
        "padding-block": "{spacing.sm}",
        "icon-size": "{spacing.105}"
      }
    },
        "sm": {
      "axis": "size",
      "description": "Compact type, padding, and icon sizing.",
      "overrides": {
        "font-size": "{font-size.sm}",
        "padding-inline": "{spacing.xs}",
        "padding-block": "{spacing.xs}",
        "icon-size": "{spacing.105}"
      }
    },
    "ghost": {
      "axis": "style",
      "overrides": {
        "canvas": "transparent",
        "canvas-hover": "{brand.ink-muted}",
        "canvas-active": "{brand.ink-muted}",
        "canvas-focus": "{brand.ink-muted}",
        "canvas-disabled": "{disabled.canvas}",
        "ink": "{brand.ink}",
        "ink-hover": "{brand.ink-emphasis}",
        "ink-active": "{brand.ink-emphasis}",
        "ink-focus": "{brand.ink-emphasis}",
        "ink-disabled": "{disabled.ink}",
        "border-width": "0",
        "border-color": "transparent",
        "border-color-hover": "transparent",
        "border-color-active": "transparent",
        "border-color-focus": "transparent",
        "border-radius": "{border.radius-md}"
      }
    },
    "code-block-copy": {
      "axis": "style",
      "description": "Copy action colors and shape owned by Code Block.",
      "overrides": {
        "ink": "{app.ink}",
        "ink-hover": "{app.ink-emphasis}",
        "ink-active": "{app.ink-emphasis}",
        "ink-focus": "{app.ink-emphasis}",
        "canvas": "{code-block.bar-canvas}",
        "canvas-hover": "{brand.100}",
        "canvas-active": "{brand.200}",
        "canvas-focus": "{brand.100}",
        "border-color": "{app.border-muted}",
        "border-color-hover": "{app.border}",
        "border-color-active": "{app.border-emphasis}",
        "border-color-focus": "{app.border-emphasis}",
        "border-width": "0px",
        "border-style": "{border.style}",
        "border-radius": "{border.radius-sm}",
        "text-decoration": "none",
        "text-align": "center",
        "text-box-trim": "none",
        "text-box-edge": "auto",
        "cursor": "pointer"
      }
    },
    "code-block-copy-size": {
      "axis": "size",
      "description": "Compact target and typography for the Code Block Copy action.",
      "overrides": {
        "min-width": "{a11y.min-interaction-size}",
        "min-height": "{a11y.min-interaction-size}",
        "padding-inline": "{spacing.sm}",
        "padding-inline-start": "{spacing.sm}",
        "padding-inline-end": "{spacing.sm}",
        "padding-block": "{spacing.xs}",
        "padding-block-start": "{spacing.xs}",
        "padding-block-end": "{spacing.xs}",
        "gap": "{spacing.xs}",
        "icon-size": "{font-size.xs}",
        "icon-start-size": "{font-size.xs}",
        "icon-end-size": "{font-size.xs}",
        "font-family": "{font-family.interface}",
        "font-size": "{font-size.xs}",
        "font-weight": "{font-weight.medium}",
        "line-height": "{line-height.2}",
        "letter-spacing": "{letter-spacing.normal}",
        "text-transform": "none"
      }
    },
    "code-block-copy-motion": {
      "axis": "effect",
      "description": "Flat, restrained interaction motion for the Code Block Copy action.",
      "overrides": {
        "box-shadow": "{elevation.none}",
        "box-shadow-hover": "{elevation.none}",
        "box-shadow-active": "{elevation.none}",
        "box-shadow-focus": "{elevation.none}",
        "transform": "none",
        "transform-hover": "none",
        "transform-active": "none",
        "transform-focus": "none",
        "transition-duration": "150ms",
        "transition-timing-function": "ease-out",
        "transition-property": "background-color, color, border-color, box-shadow, transform, outline",
        "transition-delay": "0ms",
        "opacity": 1
      }
    },
    "wave-pop": {
      "axis": "effect",
      "description": "Offset blended surface that settles on hover and press for Dynamowaves actions.",
      "overrides": {
        "box-shadow": "var(--zbk-spacing-05) var(--zbk-spacing-05) 0 var(--zbk-spacing-2px) color-mix(in srgb, var(--zbk-brand-canvas-muted) 50%, transparent)",
        "box-shadow-hover": "0 0 0 0 color-mix(in srgb, var(--zbk-brand-canvas-muted) 50%, transparent)",
        "box-shadow-active": "0 0 0 0 color-mix(in srgb, var(--zbk-brand-canvas-muted) 50%, transparent)",
        "box-shadow-focus": "0 0 0 0 color-mix(in srgb, var(--zbk-brand-canvas-muted) 50%, transparent)",
        "box-shadow-disabled": "none",
        "transform": "none",
        "transform-hover": "none",
        "transform-active": "scale(.985)",
        "transform-focus": "none",
        "transform-disabled": "none",
        "transition-duration": "{transition.duration-default}",
        "transition-timing-function": "{transition.playful-fx-function-default}",
        "transition-delay": "0ms"
      }
    },
    "wave-action": {
      "axis": "style",
      "description": "Outlined, elevated action treatment matching the Dynamowaves demo controls.",
      "overrides": {
        "canvas": "transparent",
        "canvas-hover": "color-mix(in srgb, var(--zbk-brand-canvas-muted) 32.5%, transparent)",
        "canvas-active": "color-mix(in srgb, var(--zbk-brand-canvas-muted) 70%, transparent)",
        "ink": "{brand.ink-emphasis}",
        "ink-hover": "{brand.ink-emphasis}",
        "ink-active": "{brand.ink-emphasis}",
        "border-color": "{brand.canvas}",
        "border-color-hover": "{brand.canvas}",
        "border-color-active": "{brand.canvas}",
        "border-width": "{border.width-sm}",
        "border-radius": "{border.radius-md}"
      }
    },
    "wave-action-strong": {
      "axis": "style",
      "description": "Filled action treatment for controls placed on branded demo surfaces.",
      "overrides": {
        "canvas": "{brand.canvas-subtle}",
        "canvas-hover": "{brand.canvas-subtle}",
        "canvas-active": "{brand.canvas-subtle}",
        "ink": "{brand.ink-emphasis}",
        "ink-hover": "{brand.ink-emphasis}",
        "ink-active": "{brand.ink-emphasis}",
        "border-color": "{brand.canvas-subtle}",
        "border-color-hover": "{brand.canvas-subtle}",
        "border-color-active": "{brand.canvas-subtle}",
        "border-width": "0px",
        "border-radius": "{border.radius-md}"
      }
    }
  }
}
